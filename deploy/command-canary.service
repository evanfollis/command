[Unit]
Description=Command hardening canary
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/workspace/runtime/releases/command/current
Environment=NODE_ENV=production
EnvironmentFile=/opt/workspace/projects/command/.env.local
Environment=PORT=3310
ExecStart=/opt/workspace/runtime/toolchains/node-24-current/bin/node dist/server.js
Restart=no
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/workspace
ReadWritePaths=/opt/workspace/runtime/.telemetry
InaccessiblePaths=/root/.ssh /root/.gnupg /root/.aws /root/.config/gh /opt/workspace/runtime/.secrets
