[Unit]
Description=Command authenticated read-only owner observatory
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=command
Group=command
WorkingDirectory=/opt/workspace/runtime/releases/command/current
Environment=NODE_ENV=production
EnvironmentFile=/opt/workspace/projects/command/.env.local
ExecStart=/opt/workspace/runtime/toolchains/node-24-current/bin/node dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/opt/workspace
ReadWritePaths=/opt/workspace/runtime/.telemetry
InaccessiblePaths=-/root/.ssh -/root/.gnupg -/root/.aws -/root/.config/gh -/root/.claude.json -/root/.claude/.credentials.json -/opt/workspace/runtime/.secrets /opt/workspace/projects/command/.env.local

[Install]
WantedBy=multi-user.target
