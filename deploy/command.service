[Unit]
Description=Command authenticated read-only owner observatory
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=command
Group=command
WorkingDirectory=/opt/workspace/runtime/releases/command/current
Environment=NODE_ENV=production
EnvironmentFile=/opt/workspace/projects/command/.env.local
ExecStartPre=/usr/bin/test ! -r /opt/workspace/projects/command/.env.local
ExecStartPre=/usr/bin/test ! -r /opt/workspace/runtime/prompteval/.provenance
ExecStartPre=/usr/bin/test ! -x /opt/workspace/projects/command/.prompteval/codex-task-prompt/golden
ExecStartPre=/usr/bin/test ! -x /opt/workspace/projects/command/.prompteval/offline-synthesis-prompt/golden
ExecStartPre=/usr/bin/test ! -x /opt/workspace/projects/command/.prompteval/repository-instructions/golden
ExecStartPre=/usr/bin/test ! -x /opt/workspace/projects/command/.prompteval/review-prompt/golden
ExecStartPre=/usr/bin/test ! -x /opt/workspace/projects/command/.prompteval/thread-opening-frame/golden
ExecStart=/opt/workspace/runtime/toolchains/node-24-current/bin/node dist/server.js
Restart=on-failure
RestartSec=5
UMask=0077
TasksMax=64
MemoryMax=512M
LimitNOFILE=4096

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
PrivateMounts=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @privileged @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/opt/workspace
ReadWritePaths=/opt/workspace/runtime/.telemetry
InaccessiblePaths=-/root/.ssh -/root/.gnupg -/root/.aws -/root/.config/gh -/root/.claude.json -/root/.claude/.credentials.json -/opt/workspace/runtime/.secrets -/opt/workspace/runtime/prompteval/.provenance -/opt/workspace/runtime/prompteval/.transcripts /opt/workspace/projects/command/.env.local /opt/workspace/projects/command/.prompteval/codex-task-prompt/golden /opt/workspace/projects/command/.prompteval/offline-synthesis-prompt/golden /opt/workspace/projects/command/.prompteval/repository-instructions/golden /opt/workspace/projects/command/.prompteval/review-prompt/golden /opt/workspace/projects/command/.prompteval/thread-opening-frame/golden

[Install]
WantedBy=multi-user.target
