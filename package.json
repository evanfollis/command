{
  "name": "command",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "dev": "tsx server.ts",
    "check": "npm run lint && npm run typecheck && npm run test:contracts && npm run repo:check && npm run eval:check",
    "lint": "node --import tsx scripts/check-patterns.ts && npm run product-boundary:test",
    "repo:check": "python3 scripts/repository-contract-check.py",
    "eval:check": "python3 scripts/prompteval-check.py",
    "eval:check:full": "/opt/workspace/supervisor/scripts/prompteval check .",
    "audit:security": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test:contracts": "npm run auth:test && npm run health:test && npm run bounded-file:test && npm run claude-session:test && npm run observatory:test && npm run artifacts:test && npm run symphony-projection:test && npm run eval-telemetry:test && npm run prompteval-config:test && npm run prompteval-safe-metadata:test && npm run adapter-llm-contract:test && npm run golden-contract:test && npm run thread-opening-contract:test && npm run repository-instructions-contract:test && npm run review-prompt-contract:test && npm run offline-synthesis-contract:test && npm run codex-task-builder:test && npm run service:test",
    "test": "npm run test:contracts",
    "build": "npm run check && bash scripts/build-production.sh",
    "start": "NODE_ENV=production node dist/server.js",
    "smoke": "tsx scripts/smoke.ts",
    "browser:setup": "bash scripts/browser-libs-setup.sh",
    "browser:smoke": "bash scripts/browser-smoke-wrapper.sh",
    "observatory:test": "node --import tsx scripts/observatory-test.ts",
    "artifacts:test": "node --import tsx scripts/artifacts-contract-test.ts",
    "symphony-projection:test": "node --import tsx scripts/symphony-projection-test.ts",
    "auth:test": "node --import tsx scripts/auth-contract-test.ts",
    "health:test": "node --import tsx scripts/health-contract-test.ts",
    "bounded-file:test": "node --import tsx scripts/bounded-file-contract-test.ts",
    "claude-session:test": "node --import tsx scripts/claude-session-contract-test.ts",
    "product-boundary:test": "node --import tsx scripts/product-boundary-test.ts",
    "eval-telemetry:test": "node --import tsx scripts/eval-telemetry-test.ts",
    "prompteval-config:test": "node --import tsx scripts/prompteval-config-test.ts",
    "prompteval-safe-metadata:test": "python3 scripts/prompteval-safe-metadata-test.py",
    "adapter-llm-contract:test": "python3 scripts/adapter-llm-contract-test.py",
    "golden-contract:test": "python3 scripts/golden-contract-test.py",
    "thread-opening-contract:test": "python3 scripts/thread-opening-contract-test.py",
    "repository-instructions-contract:test": "python3 scripts/repository-instructions-contract-test.py",
    "review-prompt-contract:test": "python3 scripts/review-prompt-contract-test.py",
    "codex-task-builder:test": "node --import tsx scripts/codex-task-builder-test.ts",
    "service:test": "bash scripts/service-unit-test.sh",
    "offline-synthesis-contract:test": "python3 scripts/offline-synthesis-contract-test.py",
    "deploy": "bash scripts/release.sh",
    "meta:scan": "tsx scripts/meta-scan.ts",
    "release:rollback": "bash scripts/rollback.sh",
    "release:test": "bash scripts/release-invariants-test.sh",
    "service:install": "bash scripts/install-service-unit.sh",
    "runtime:setup": "bash scripts/install-node-runtime.sh",
    "deploy:check": "npm run check && npm run release:test && /opt/workspace/supervisor/scripts/lib/preflight-deploy.sh ."
  },
  "dependencies": {
    "jose": "^6.2.4",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.0",
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0"
  }
}
